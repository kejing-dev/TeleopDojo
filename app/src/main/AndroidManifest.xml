<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No permissions: no planes, anchors, scene mesh, camera, microphone or network (design container.permissions); controllers need none. -->

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeleopDojoTheme"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.TeleopDojoTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DefaultStage: design container STAGE_MIXED (Full Space, passthrough): controller pose and grip / trigger values exist only in Full Space. -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="TeleopDojoStage" />

            <!-- "1": StageStyle.Mixed: virtual content and the real room at full intensity -->
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="1" />

            <meta-data
                android:name="pico.spatial.stage.immersion"
                android:value="100" />
            <meta-data
                android:name="pico.spatial.stage.immersion_min"
                android:value="100" />
            <meta-data
                android:name="pico.spatial.stage.immersion_max"
                android:value="100" />

        </activity>

        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
